# Chave direta API-Sports/API-Football (não é chave RapidAPI).
API_FOOTBALL_KEY=
# IDs de ligas separados por vírgula; 71 = Série A do Brasil.
LEAGUE_IDS=71
TIMEZONE=America/Sao_Paulo
DAYS_AHEAD=3
REFRESH_MINUTES=30
DATABASE_PATH=data/football.sqlite3
# Limites locais conservadores. Ajuste conforme o plano contratado.
MAX_REQUESTS_PER_DAY=90
MAX_REQUESTS_PER_REFRESH=35
MAX_FIXTURES=12
# Ative apenas se seu plano autoriza odds/desfalques/estatísticas detalhadas.
ENABLE_ODDS=false
ENABLE_INJURIES=false
ENABLE_DETAILED_STATS=false
ODDS_MAX_AGE_MINUTES=60
# Token aleatório opcional para POST /api/refresh. Sem token, só atualização automática.
ADMIN_TOKEN=

# Casa de interesse; o nome não prova cobertura pelo fornecedor.
PREFERRED_BOOKMAKER_NAME=83bets
# Preencha apenas com ID confirmado no endpoint /odds/bookmakers da API.
# Quando informado, SOMENTE odds dessa casa são comparadas.
PREFERRED_BOOKMAKER_ID=
